{
  "name": "plataforma-apoyo-academico-backend",
  "version": "0.1.0",
  "description": "API REST de la Plataforma de Apoyo Académico (proyecto de aula - Ingeniería de Software)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "crear-admin": "node src/db/crear-admin.js",
    "datos-prueba": "node src/db/datos-prueba.js",
    "test": "node --test test/api.test.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.11.5"
  }
}
