# Copie este archivo como .env y complete los valores (el .env NO se sube a GitHub).

# Puerto del Backend API
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apoyo_academico
DB_USER=apoyo_academico
DB_PASSWORD=

# JWT (RF-02 / RNF-04). Use una cadena larga y aleatoria, distinta en cada entorno.
# Por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Carpeta donde se guardan los archivos subidos (relativa a backend/)
UPLOADS_DIR=uploads

# Tutor IA (RF-14 a RF-19). Proveedor de IA: 'gemini' (gratuito, por defecto) o 'claude'.
# Sin clave, la plataforma funciona igual: el Tutor IA aparece como «no configurado» y el
# material se publica sin revisión automática.
IA_PROVEEDOR=gemini
# Google Gemini (nivel gratuito): cree la clave en https://aistudio.google.com/apikey
# En el nivel gratuito, Google puede usar el contenido enviado para mejorar sus productos.
GEMINI_API_KEY=
IA_MODELO_GEMINI=gemini-3.5-flash-lite
# Si el principal está saturado o sin cuota, se prueban estos (también gratuitos).
IA_MODELOS_RESPALDO_GEMINI=gemini-3.8-flash,gemini-2.5-flash
# Claude de Anthropic (de pago, opcional): clave en https://platform.claude.com
ANTHROPIC_API_KEY=
IA_MODELO_CLAUDE=claude-opus-5-5
IA_ESFUERZO=medium
# Consultas nuevas al Tutor IA que puede hacer cada usuario por hora (R-13).
IA_LIMITE_POR_HORA=20
