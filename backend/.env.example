# Copie este archivo como .env y complete los valores (el .env NO se sube a GitHub).

# Puerto del Backend API
PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=apoyo_academico
DB_USER=apoyo_academico
DB_PASSWORD=

# JWT (RF-02 / RNF-04). Use una cadena larga y aleatoria, distinta en cada entorno.
# Por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Carpeta donde se guardan los archivos subidos (relativa a backend/)
UPLOADS_DIR=uploads

# Tutor IA (RF-14 a RF-16). La clave se crea en https://platform.claude.com
# (API Keys). Sin clave, la plataforma funciona igual pero el Tutor IA aparece
# como «no configurado».
ANTHROPIC_API_KEY=
# Modelo de Claude y nivel de esfuerzo (low | medium | high): más esfuerzo,
# respuestas más cuidadosas pero más lentas y costosas.
IA_MODELO=claude-opus-5-5
IA_ESFUERZO=medium
# Consultas nuevas al Tutor IA que puede hacer cada usuario por hora (R-13).
IA_LIMITE_POR_HORA=20
